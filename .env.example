# =============================================================================
# Serene Insurance Customer Feedback System ("serene-pulse"): environment file
# =============================================================================
# HOW THIS FILE WORKS
#   * .env.example (this file) is committed and holds NO real values.
#   * Copy it to .env (git-ignored) and fill it in. `node scripts/env-check.mjs`
#     reports what is still missing for each milestone.
#   * .env is the single place you type values. At MS-01, `scripts/sync-secrets`
#     pushes each value to where it actually runs (destinations below). The app
#     never reads .env in staging/production.
#   * Local development needs no cloud keys: `supabase start` prints local keys
#     and `wrangler dev` uses .dev.vars (generated from the LOCAL section).
#
# LEGEND (shown after each variable)
#   SECRET  never share, never paste in chat, never put in the portal bundle
#   PUBLIC  safe in browser code / the repo, but still environment-specific
#   GEN     generated by `node scripts/env-check.mjs --generate` (random 32 bytes),
#           so you don't need to obtain it anywhere
#   Destinations: [W] survey Worker secret, [P] portal build (Vite, public only),
#   [E] Supabase Edge Function secret, [V] Supabase Vault, [G] GitHub Actions
#   secret, [CLI] your machine only
#   Xnn = the EXTERNAL ACTION in docs/external-actions.md that produces the value
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Hostnames: Cloudflare workers.dev subdomain (D-37). No custom domain is used.
#    Workers & Pages > overview shows the account subdomain (<subdomain>.workers.dev).
# -----------------------------------------------------------------------------
WORKERS_SUBDOMAIN=                  # PUBLIC  [G]
SURVEY_HOST_PRODUCTION=serene-pulse-survey.${WORKERS_SUBDOMAIN}.workers.dev           # PUBLIC
PORTAL_HOST_PRODUCTION=serene-pulse-portal.${WORKERS_SUBDOMAIN}.workers.dev           # PUBLIC
SURVEY_HOST_STAGING=serene-pulse-survey-staging.${WORKERS_SUBDOMAIN}.workers.dev      # PUBLIC
PORTAL_HOST_STAGING=serene-pulse-portal-staging.${WORKERS_SUBDOMAIN}.workers.dev      # PUBLIC

# -----------------------------------------------------------------------------
# 1. Cloudflare (X-02, X-03): dash.cloudflare.com
# -----------------------------------------------------------------------------
# Account ID: right sidebar of any zone's Overview page.
CLOUDFLARE_ACCOUNT_ID=  # PUBLIC  [G][CLI]
# Zone ID: only needed if a custom domain is added later (D-37 uses workers.dev).
CLOUDFLARE_ZONE_ID=                       # PUBLIC  [G][CLI]
# API token: My Profile > API Tokens > Create Token > Custom. Permissions:
#   Account: Workers Scripts:Edit, Workers R2 Storage:Edit, Turnstile:Edit (optional)
CLOUDFLARE_API_TOKEN=   # SECRET  [G][CLI]
# Web Analytics beacon token (Web Analytics > Add site > copy the token from the snippet).
CF_WEB_ANALYTICS_TOKEN=                   # PUBLIC  [W]

# Turnstile (X-04, needed by MS-05): Turnstile > Add widget, mode "Managed".
# One widget per environment, limited to that environment's survey host (created via API).
TURNSTILE_SITE_KEY_STAGING=               # PUBLIC  [W]
TURNSTILE_SECRET_KEY_STAGING=             # SECRET  [W]
TURNSTILE_SITE_KEY_PRODUCTION=            # PUBLIC  [W]
TURNSTILE_SECRET_KEY_PRODUCTION=          # SECRET  [W]

# R2 backups (X-05): R2 > Create bucket "serene-pulse-backups" (location hint: WEUR).
# Then R2 > Manage R2 API Tokens > Create token: "Object Read & Write", that bucket only.
R2_BACKUP_BUCKET=serene-pulse-backups     # PUBLIC  [G]
R2_ENDPOINT=https://${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com  # PUBLIC [G]
R2_ACCESS_KEY_ID=                         # SECRET  [G]
R2_SECRET_ACCESS_KEY=                     # SECRET  [G]
# age public key (age-keygen output line "Public key: age1..."). Keep the PRIVATE key
# OFFLINE (password manager + printed copy). It must never appear in this file.
BACKUP_AGE_PUBLIC_KEY=                    # PUBLIC  [G]

# -----------------------------------------------------------------------------
# 2. Supabase (X-02): supabase.com/dashboard. Two projects, region eu-west-2 London
# -----------------------------------------------------------------------------
# Personal access token for the CLI and CI: Account > Access Tokens.
SUPABASE_ACCESS_TOKEN=  # SECRET  [G][CLI]

# --- STAGING project ---
# Project ref = the id in the dashboard URL (supabase.com/dashboard/project/<ref>).
SUPABASE_PROJECT_REF_STAGING=             # PUBLIC  [G][CLI]
SUPABASE_URL_STAGING=https://${SUPABASE_PROJECT_REF_STAGING}.supabase.co  # PUBLIC [W][P][E]
# Project Settings > API Keys. Paste the publishable key (sb_publishable_...) or the
# legacy "anon" JWT. Either works.
SUPABASE_ANON_KEY_STAGING=                # PUBLIC  [P][W]
# Project Settings > API Keys. Paste the secret key (sb_secret_...) or the legacy
# "service_role" JWT. Only the Worker, Edge Functions and CI may ever hold it.
SUPABASE_SERVICE_ROLE_KEY_STAGING=        # SECRET  [W][E][G]
# The database password you chose when creating the project (Settings > Database to reset).
SUPABASE_DB_PASSWORD_STAGING=             # SECRET  [G][CLI]
# Connect > Session pooler URI (IPv4; GitHub runners have no IPv6). Contains the password.
SUPABASE_DB_URL_STAGING=                  # SECRET  [G]

# --- PRODUCTION project ---
SUPABASE_PROJECT_REF_PRODUCTION=          # PUBLIC  [G][CLI]
SUPABASE_URL_PRODUCTION=https://${SUPABASE_PROJECT_REF_PRODUCTION}.supabase.co  # PUBLIC [W][P][E]
SUPABASE_ANON_KEY_PRODUCTION=             # PUBLIC  [P][W]
SUPABASE_SERVICE_ROLE_KEY_PRODUCTION=     # SECRET  [W][E][G]
SUPABASE_DB_PASSWORD_PRODUCTION=          # SECRET  [G][CLI]
SUPABASE_DB_URL_PRODUCTION=               # SECRET  [G]

# -----------------------------------------------------------------------------
# 3. Application keys. Generated, never obtained from a provider (GEN).
#    Separate per environment. Rotating one is a runbook step (docs/runbooks).
# -----------------------------------------------------------------------------
# HMAC for survey session secrets and device ids (__Host-svs / __Host-svd), A-12/A-123.
SURVEY_HMAC_KEY_STAGING=                  # SECRET GEN  [W]
SURVEY_HMAC_KEY_PRODUCTION=               # SECRET GEN  [W]
# Key-encryption key for consented phone numbers / names (pii schema, A-19).
# Loaded once into Supabase Vault as "pii_kek". Losing it makes contact data unreadable.
PII_KEK_STAGING=                          # SECRET GEN  [V]
PII_KEK_PRODUCTION=                       # SECRET GEN  [V]
# HMAC for phone-number matching (repeat complaints, data-subject lookups, A-109).
PII_HMAC_KEY_STAGING=                     # SECRET GEN  [V]
PII_HMAC_KEY_PRODUCTION=                  # SECRET GEN  [V]
# Shared secret that pg_net jobs send to Edge Functions (scheduled reports, email drain).
JOBS_SHARED_SECRET_STAGING=               # SECRET GEN  [E][V]
JOBS_SHARED_SECRET_PRODUCTION=            # SECRET GEN  [E][V]

# -----------------------------------------------------------------------------
# 4. Email: Resend (X-06), resend.com
# -----------------------------------------------------------------------------
# Domains > Add domain (use the root domain or mail.<root>), add the SPF/DKIM records in
# Cloudflare DNS, add DMARC (v=DMARC1; p=quarantine; rua=...). Then API Keys > Create
# ("Sending access", that domain only). The same key is set as Supabase Auth SMTP password.
RESEND_API_KEY=                           # SECRET  [E] + Supabase Auth SMTP
EMAIL_FROM=Serene Insurance <no-reply@<verified sending domain>>   # PUBLIC [E]
EMAIL_REPLY_TO=                           # PUBLIC  [E] e.g. the CX team mailbox
EMAIL_DAILY_BUDGET=90                     # PUBLIC  [E] stays under Resend free 100/day (A-129)

# -----------------------------------------------------------------------------
# 5. Monitoring (X-07): Sentry (free) and an uptime monitor
# -----------------------------------------------------------------------------
# sentry.io > Projects: create "survey-worker", "portal", "edge-functions"; copy each DSN.
SENTRY_DSN_SURVEY=                        # PUBLIC  [W]
SENTRY_DSN_PORTAL=                        # PUBLIC  [P]
SENTRY_DSN_EDGE=                          # PUBLIC  [E]
SENTRY_ORG=                               # PUBLIC  [G]
# Settings > Auth Tokens (org token, scope project:releases) for source-map upload in CI.
SENTRY_AUTH_TOKEN=                        # SECRET  [G]
# Heartbeat URL from Better Stack / UptimeRobot / healthchecks.io. The nightly backup job
# pings it; a missing ping for 26 h raises the "no backup" alert (MONITORING).
BACKUP_HEARTBEAT_URL=                     # SECRET  [G]

# -----------------------------------------------------------------------------
# 6. Seed administrator (X-08, D-23, A-120)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=manuelbartimeus@gmail.com                     # PUBLIC  [CLI][G]
# Choose a NEW password, 12+ characters. NOT the one shared in chat on 2026-11-04.
# You must change it at first sign-in anyway. Delete it from .env after seeding.
SEED_ADMIN_PASSWORD=                      # SECRET  [CLI][G]

# -----------------------------------------------------------------------------
# 7. Company settings seeded into the `settings` table (editable later in the portal)
# -----------------------------------------------------------------------------
COMPANY_DISPLAY_NAME=Serene Insurance                          # PUBLIC
COMPANY_LEGAL_NAME=Serene Insurance LTD                        # PUBLIC
SUPPORT_PHONE=                            # PUBLIC e.g. +233 30 000 0000 (shown on error pages)
SUPPORT_EMAIL=                            # PUBLIC
# Data-protection contact for the privacy notice (Act 843). Needed by MS-09 (X-09).
DATA_PROTECTION_CONTACT_EMAIL=            # PUBLIC
DPC_REGISTRATION_NUMBER=                  # PUBLIC (from your Data Protection Commission certificate)

# -----------------------------------------------------------------------------
# 8. GitHub (X-01)
# -----------------------------------------------------------------------------
GITHUB_REPOSITORY=                        # PUBLIC  owner/repo, e.g. serene-insurance/serene-pulse
# Fine-grained PAT, this repo only: Contents R/W, Secrets R/W, Environments R/W, Actions R/W,
# Administration R/W (branch protection). Used once by scripts/sync-secrets to load GitHub
# environment secrets; CI itself uses its built-in GITHUB_TOKEN.
GITHUB_PAT=                               # SECRET  [CLI]
