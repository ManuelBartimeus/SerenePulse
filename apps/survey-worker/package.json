{
  "name": "@serene/survey-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:island": "node scripts/build-island.mjs",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "node scripts/build-island.mjs && tsc -p . && tsc -p island",
    "test": "node scripts/build-island.mjs && vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@serene/contracts": "workspace:*",
    "@serene/proposals": "workspace:^",
    "@serene/survey-engine": "workspace:^",
    "hono": "^4.13.16",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "esbuild": "^0.28.2",
    "wrangler": "^4.157.0"
  }
}
